<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Only strip /index.php from public-facing requests.
    # Do not redirect Concrete internal dashboard/system routes.
    RewriteCond %{REQUEST_METHOD} GET
    RewriteCond %{THE_REQUEST} \s/+index\.php[/?\s]
    RewriteCond %{THE_REQUEST} !\s/+index\.php/(ccm|dashboard)(/|\s|\?)
    RewriteRule ^index\.php/?$ / [R=301,L,NE]

    RewriteCond %{REQUEST_METHOD} GET
    RewriteCond %{THE_REQUEST} \s/+index\.php/
    RewriteCond %{THE_REQUEST} !\s/+index\.php/(ccm|dashboard)(/|\s|\?)
    RewriteRule ^index\.php/(.*)$ /$1 [R=301,L,NE]

    RewriteRule ^community/cheesy-nachos/?$ /community/youth [R=301,L,NE]
    RewriteRule ^community/men/?$ /community/mens-ministry [R=301,L,NE]
    RewriteRule ^community/women/?$ /community/womens-ministry [R=301,L,NE]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php/$1 [L]
</IfModule>

<IfModule mod_setenvif.c>
    SetEnvIfNoCase Request_URI "^/application/themes/millbrook/.*\.(css|js|mjs|png|jpe?g|gif|webp|svg|ico|woff2?)(\?.*)?$" millbrook_theme_asset=1
</IfModule>

<IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable" env=millbrook_theme_asset
</IfModule>
