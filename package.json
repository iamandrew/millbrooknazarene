{
  "name": "millbrookchurch",
  "private": true,
  "scripts": {
    "build:css": "sass --style=expanded --no-source-map application/themes/millbrook/scss/main.scss application/themes/millbrook/css/main.css",
    "watch:css": "sass --watch --style=expanded --no-source-map application/themes/millbrook/scss/main.scss:application/themes/millbrook/css/main.css",
    "deploy:staging": "scripts/deploy/deploy.sh staging",
    "deploy:staging:content": "scripts/deploy/deploy.sh staging --with-content",
    "deploy:production": "scripts/deploy/deploy.sh production",
    "seed:help": "php concrete/bin/concrete c5:exec application/themes/millbrook/scripts/seed.php -- help",
    "seed:inspect": "php concrete/bin/concrete c5:exec application/themes/millbrook/scripts/seed.php -- inspect",
    "seed:deploy": "php concrete/bin/concrete c5:exec application/themes/millbrook/scripts/seed.php -- deploy",
    "seed:staging-content": "php concrete/bin/concrete c5:exec application/themes/millbrook/scripts/seed.php -- staging-content",
    "seed:visit-us": "php concrete/bin/concrete c5:exec application/themes/millbrook/scripts/seed.php -- visit-us",
    "seed:who-we-are": "php concrete/bin/concrete c5:exec application/themes/millbrook/scripts/seed.php -- who-we-are",
    "seed:womens-ministry": "php concrete/bin/concrete c5:exec application/themes/millbrook/scripts/seed.php -- womens-ministry",
    "seed:creche": "php concrete/bin/concrete c5:exec application/themes/millbrook/scripts/seed.php -- creche",
    "seed:youth": "php concrete/bin/concrete c5:exec application/themes/millbrook/scripts/seed.php -- youth",
    "seed:giving": "php concrete/bin/concrete c5:exec application/themes/millbrook/scripts/seed.php -- giving",
    "seed:hero-attributes": "php concrete/bin/concrete c5:exec application/themes/millbrook/scripts/seed.php -- hero-attributes",
    "seed:demo-sitemap": "php concrete/bin/concrete c5:exec application/themes/millbrook/scripts/seed.php -- demo-sitemap",
    "seed:new-here": "php concrete/bin/concrete c5:exec application/themes/millbrook/scripts/seed.php -- new-here",
    "seed:visitor-blueprint": "php concrete/bin/concrete c5:exec application/themes/millbrook/scripts/seed.php -- visitor-blueprint",
    "seed:all": "php concrete/bin/concrete c5:exec application/themes/millbrook/scripts/seed.php -- all"
  },
  "devDependencies": {
    "sass": "^1.77.8"
  },
  "dependencies": {
    "plyr": "^3.8.4"
  }
}
